---
checkpoints:
  sd15:
    path: 'models/checkpoints/SD15'
  sdxl:
    path: 'models/checkpoints/SDXL'
  illustrious:
    path: 'models/checkpoints/Illustrious'
  flux:
    path: 'models/checkpoints/Flux'

loras:
  sd15:
    path: 'models/loras/SD15'
  sdxl:
    path: 'models/loras/SDXL'
  illustrious:
    path: 'models/loras/Illustrious'
  flux:
    path: 'models/loras/Flux'

vaes:
  sd15:
    path: 'models/vae/SD15'
  sdxl:
    path: 'models/vae/SDXL'
  illustrious:
    path: 'models/vae/Illustrious'
  flux:
    path: 'models/vae/Flux'

# Flux checkpoints only ship the transformer as a single safetensors file.
# The shared text encoders/tokenizers/VAE/scheduler come from a local
# diffusers-format directory, loaded once and reused across all Flux checkpoints.
flux:
  components_path: 'models/flux_components'

# Compute device selection (optional section; defaults shown).
#   backend: auto-detects in order mps -> cuda/rocm -> cpu. PyTorch ROCm builds
#     expose AMD GPUs through the CUDA API, so an AMD card reports "rocm"
#     (NVIDIA reports "cuda"). Force with: auto | cuda | rocm | mps | cpu
#   index: GPU ordinal for multi-GPU hosts.
#   dtype: auto | float16 | bfloat16 | float32. "auto" picks float32 on CPU and
#     float16 on accelerators; ROCm stays on float16 because bfloat16 is not
#     reliably supported on older RDNA GPUs (set it explicitly on RDNA2+).
#   gfx_override: sets HSA_OVERRIDE_GFX_VERSION before HIP initialization.
#     Required for AMD cards missing from the ROCm support matrix - e.g. the
#     RX 5500 XT is gfx1034, so gfx_override: "10.3.0" presents it as gfx1030.
#   env: extra environment variables applied before PyTorch initializes HIP/CUDA.
device:
  backend: auto
  index: 0
  dtype: auto
  # gfx_override: "10.3.0"   # e.g. RX 5500 XT (gfx1034) on ROCm
  # env: {}

storage:
  persist_to_backend: true
  output_images: 'outputs/images'
  output_json: 'outputs/json'

api:
  host: "0.0.0.0"
  port: 8000
  workers: 1
  job_queue:
    num_workers: 1
    result_ttl: 3600
  model_cache:
    max_models: 2
  cors:
    enabled: true
    allow_origins: ["*"]
